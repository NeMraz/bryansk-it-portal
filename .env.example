# Пример переменных для сервера. Замените значения; не храните настоящий .env в Git.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.ru,www.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru
DJANGO_HTTPS=1
DJANGO_ADMIN_URL=panel-x7k2/
